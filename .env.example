PGHOST=127.0.0.1
PGPORT=55439
PGDATABASE=inkwell
# PGUSER and PGPASSWORD are optional for the isolated local cluster.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# For production, set DJANGO_DEBUG=0 and provide a unique DJANGO_SECRET_KEY.

PUBLIC_SITE_URL=http://127.0.0.1:5173
# Optional overrides used by Docker Compose (local defaults work without these):
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DJANGO_SESSION_COOKIE_NAME=sessionid
# DJANGO_CSRF_COOKIE_NAME=csrftoken
